# Optional: full public origin used in metadata, sitemap, RSS, and sharing links.
# Vercel builds automatically use VERCEL_PROJECT_PRODUCTION_URL when omitted.
# Local development defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Only needed if password-protected routes are enabled in once-ui.config.ts.
# PAGE_ACCESS_PASSWORD=replace-with-a-strong-password
